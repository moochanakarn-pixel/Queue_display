<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <httpErrors existingResponse="PassThrough" />
        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/manifest+json" />
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        </staticContent>
        <defaultDocument>
            <files>
                <add value="index.php" />
            </files>
        </defaultDocument>
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="php_errors.log" />
                    <add segment="settings.local.php" />
                    <add segment="manual_ready.local.php" />
                </hiddenSegments>
                <requestLimits maxAllowedContentLength="6291456" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
